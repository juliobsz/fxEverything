{
  "name": "fxeverything",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Silently rewrite social-media post links for richer embeds.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "bun run test:platforms && bun run test:regression",
    "test:platforms": "bun test tests/platforms.test.ts tests/i18n.test.ts",
    "test:regression": "bun run build && bun test tests/content-regression.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-zip-pack": "^1.2.4"
  }
}
